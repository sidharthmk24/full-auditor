# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/website_auditor

# Redis and BullMQ
REDIS_URL=redis://localhost:6379

# OpenAI (Backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=notifications@websiteauditor.local

# Storage (Local for dev, S3/R2 for prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication
AUTH_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Audit engine limits & safety
MAX_CRAWL_PAGES=50
MAX_CRAWL_DEPTH=3
PAGE_TIMEOUT_MS=30000
MAX_REDIRECTS=10
MAX_CONCURRENT_AUDITS=2
BROWSER_TIMEOUT_MS=30000

# Optional integrations
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

