{
  "name": "website-auditor-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=25",
    "dev:apps": "turbo run dev --filter=./apps/*",
    "dev:web": "pnpm --filter @auditor/web dev",
    "dev:api": "pnpm --filter @auditor/api dev",
    "dev:worker": "pnpm --filter @auditor/worker dev",
    "build": "turbo run build",
    "test": "node --test tests/**/*.test.ts",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "db:generate": "pnpm --filter @auditor/database db:generate",
    "db:push": "pnpm --filter @auditor/database db:push",
    "db:seed": "pnpm --filter @auditor/database db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@scarf/scarf",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "next": "15.1.7",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
