{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "25",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "WEB_URL",
    "API_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_DIR",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "AUTH_SECRET",
    "JWT_EXPIRES_IN",
    "MAX_CRAWL_PAGES",
    "MAX_CRAWL_DEPTH",
    "PAGE_TIMEOUT_MS",
    "MAX_REDIRECTS",
    "MAX_CONCURRENT_AUDITS",
    "BROWSER_TIMEOUT_MS",
    "GOOGLE_PAGESPEED_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEXT_PUBLIC_API_URL",
    "API_SERVICE_URL",
    "BACKEND_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
